FROM python:3.14-slim

# This image serves two roles:
#   1. The standalone Simulation API service (see CMD below).
#   2. The in-cluster "test pod" image Simulation launches to run the
#      trace-replayer benchmark from inside a deployment's namespace instead
#      of through a host-side kubectl port-forward. Build and push this
#      image, then point the backend at it via SIMULATION_INCLUSTER_IMAGE
#      (see llm_d_bench/simulation/incluster.py) to override the default
#      per-tool image. Kubernetes overrides this image's CMD with an idle
#      "sleep" command when launching it in that role, so no separate
#      entrypoint is required.
#      Note: aiperf in-cluster runs default to the official
#      nvcr.io/nvidia/ai-dynamo/aiperf image instead (already ships a
#      pinned aiperf build), so this image is not needed for aiperf unless
#      SIMULATION_INCLUSTER_IMAGE is explicitly overridden.
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cargo git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY llm_d_bench ./llm_d_bench
RUN pip install --no-cache-dir .

ENV LENS_DATA_DIR=/var/lib/lens
ENV LENS_CACHE_DIR=/var/cache/lens
ENV LENS_LOG_DIR=/var/log/lens

VOLUME ["/var/lib/lens", "/var/cache/lens", "/var/log/lens"]
EXPOSE 8081

CMD ["python", "-m", "uvicorn", "llm_d_bench.api:app", "--host", "0.0.0.0", "--port", "8081"]
